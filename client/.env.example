# Copy to .env.local and fill in. Without API_BASE_URL the site renders
# bundled fallback content (src/data/fallback), so it works before the backend exists.

# ---- server-only ----
# Backend API base URL, including the version prefix. No trailing slash.
API_BASE_URL=
# Request timeout for backend calls, in milliseconds.
API_TIMEOUT_MS=5000
# Shared secret the backend sends in the x-revalidate-secret header to POST /api/revalidate.
REVALIDATE_SECRET=

# ---- public (exposed to the browser) ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google AdSense publisher id, e.g. ca-pub-1234567890123456. Empty = ad placeholders.
NEXT_PUBLIC_ADSENSE_CLIENT=
