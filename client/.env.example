# Copy to .env.local and fill in. Without STRAPI_URL the site renders the
# bundled fallback content (src/data/fallback), so it works before Strapi is up.
# For local development, `npm run website:token` in ../server fills these for you.

# ---- server-only ----
# Strapi base URL, without /api. No trailing slash.
STRAPI_URL=http://localhost:1337
# Read-only API token: Strapi admin → Settings → API Tokens → Create (type "Read-only").
STRAPI_API_TOKEN=
# Request timeout for Strapi calls, in milliseconds.
API_TIMEOUT_MS=5000
# Must equal REVALIDATE_SECRET in ../server/.env (Strapi's webhook sends it).
REVALIDATE_SECRET=

# ---- public (exposed to the browser) ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional fallback AdSense publisher id; normally set in Strapi → Ad Settings.
NEXT_PUBLIC_ADSENSE_CLIENT=
