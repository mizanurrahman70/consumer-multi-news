{
  "kind": "singleType",
  "collectionName": "contact_pages",
  "info": { "singularName": "contact-page", "pluralName": "contact-pages", "displayName": "Contact Page", "description": "The /contact page. Address and phone come from Site Settings." },
  "options": { "draftAndPublish": true },
  "attributes": {
    "title": { "type": "string", "required": true, "maxLength": 100, "default": "Contact" },
    "subtitle": { "type": "text", "maxLength": 300 },
    "content": { "type": "blocks" },
    "showContactDetails": { "type": "boolean", "default": true },
    "mapLink": { "type": "string", "regex": "^(https://.+)?$" },
    "buttons": { "type": "component", "repeatable": true, "component": "shared.button", "max": 3 },
    "seo": { "type": "component", "repeatable": false, "component": "shared.seo" }
  }
}
