{
  "kind": "collectionType",
  "collectionName": "categories",
  "info": { "singularName": "category", "pluralName": "categories", "displayName": "Category", "description": "Consumer Rights, Market Watch, Enforcement Drives…" },
  "options": { "draftAndPublish": false },
  "attributes": {
    "name": { "type": "string", "required": true, "unique": true, "maxLength": 60 },
    "slug": { "type": "uid", "targetField": "name", "required": true },
    "description": { "type": "text" },
    "videos": { "type": "relation", "relation": "oneToMany", "target": "api::video.video", "mappedBy": "category" },
    "seo": { "type": "component", "repeatable": false, "component": "shared.seo" }
  }
}
