{
  "kind": "singleType",
  "collectionName": "site_settings",
  "info": { "singularName": "site-setting", "pluralName": "site-settings", "displayName": "Site Settings", "description": "Brand, contact details, social links and default SEO" },
  "options": { "draftAndPublish": false },
  "attributes": {
    "siteName": { "type": "string", "required": true, "maxLength": 60 },
    "tagline": { "type": "string", "required": true, "maxLength": 100 },
    "description": { "type": "text", "required": true, "maxLength": 300 },
    "logo": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "footerLogo": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "favicon": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "instagramHandle": { "type": "string", "required": true, "maxLength": 40 },
    "contact": { "type": "component", "repeatable": false, "component": "shared.contact", "required": true },
    "social": { "type": "component", "repeatable": false, "component": "shared.social-links", "required": true },
    "copyrightText": { "type": "string", "maxLength": 100, "default": "All rights reserved." },
    "developerCredit": { "type": "component", "repeatable": false, "component": "shared.link" },
    "defaultSeo": { "type": "component", "repeatable": false, "component": "shared.seo", "required": true },
    "organizationSchema": { "type": "component", "repeatable": false, "component": "seo.organization" }
  }
}
