{
  "kind": "singleType",
  "collectionName": "about_pages",
  "info": { "singularName": "about-page", "pluralName": "about-pages", "displayName": "About Page", "description": "The /about-us page" },
  "options": { "draftAndPublish": true },
  "attributes": {
    "title": { "type": "string", "required": true, "maxLength": 100, "default": "About us" },
